# ============================================================
#  Variables d'environnement — Vantom Sneaker Store
#  Copiez ce fichier en .env.local et remplissez les valeurs.
# ============================================================

# --- Supabase (Project Settings > API) ----------------------
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_anon_key
SUPABASE_SERVICE_ROLE_KEY=votre_service_role_key   # SECRET — jamais côté client

# --- URL publique du site (sans slash final) ----------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Paiement -----------------------------------------------
# "mock"  = simulateur (dev, paiement auto-validé hors production)
# "sebpay"= agrégateur réel
PAYMENT_PROVIDER=mock
SEBPAY_PUBLIC_KEY=
SEBPAY_SECRET_KEY=

# --- Cron de réconciliation des paiements -------------------
# Secret partagé entre Vercel Cron et la route /api/cron/reconcile-payments
CRON_SECRET=une_chaine_secrete_longue_et_aleatoire

# --- Emails transactionnels (optionnel, Resend) -------------
RESEND_API_KEY=
RESEND_FROM=Vantom <onboarding@resend.dev>
